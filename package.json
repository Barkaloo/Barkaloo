{
  "name": "barkaloo",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "build": "node build.cjs && vite build --config tutor/vite.config.ts",
    "dev:tutor": "vite --config tutor/vite.config.ts",
    "check:tutor": "tsc -p tutor/tsconfig.json --noEmit",
    "test": "node --test *.test.cjs fitness/test/*.test.cjs",
    "test:tutor": "node --test tutor/test/*.test.mjs"
  },
  "dependencies": {
    "sharp": "0.34.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/supabase-js": "2.119.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "katex": "0.19.1",
    "prismjs": "1.30.0",
    "lucide-react": "1.73.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/katex": "0.16.8",
    "@types/prismjs": "1.26.6",
    "@types/node": "26.6.6",
    "@electric-sql/pglite": "0.5.16",
    "supabase": "3.1.0"
  }
}
